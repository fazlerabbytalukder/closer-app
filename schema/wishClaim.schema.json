{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://closer.app/schema/wishClaim.schema.json",
  "title": "pairs/{pairId}/wishClaims/{wishId}",
  "description": "Secret 'I'll get this' on the partner's gift wish. Readable only by claimedBy.",
  "type": "object",
  "properties": {
    "claimedBy": {
      "$ref": "common.schema.json#/$defs/uid"
    },
    "claimedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  },
  "required": [
    "claimedBy",
    "claimedAt"
  ],
  "additionalProperties": false
}
