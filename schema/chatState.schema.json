{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://closer.app/schema/chatState.schema.json",
  "title": "pairs/{pairId}/chatState/{uid}",
  "description": "Each member's last read time and typing indicator; only that member writes it.",
  "type": "object",
  "properties": {
    "readAt": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "typingUntil": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
