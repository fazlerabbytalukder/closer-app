{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://closer.app/schema/pair.schema.json",
  "title": "pairs/{pairId}",
  "description": "Created by acceptInvite. Members may only change widgetTheme[self], questionPack, timezone, mode, anniversary, relationLabels[self], nicknames[self] and lastMetAt; everything else is function-only.",
  "type": "object",
  "properties": {
    "memberIds": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uid"}, "minItems": 2, "maxItems": 2},
    "mode": {"$ref": "common.schema.json#/$defs/pairMode"},
    "status": {"enum": ["active", "unpaired"]},
    "pairedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
    "timezone": {"type": "string"},
    "anniversary": {"oneOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}], "description": "Together / friends since."},
    "relationLabels": {
      "type": "object",
      "description": "uid -> what that member calls their partner.",
      "additionalProperties": {"enum": ["girlfriend", "boyfriend", "partner", "wife", "husband", "fiance", "best_friend", "bff", "bestie", "sibling"]}
    },
    "nicknames": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 24}},
    "dateGoal": {
      "oneOf": [
        {"type": "object", "properties": {"count": {"type": "integer", "minimum": 1, "maximum": 14}, "per": {"enum": ["week", "month"]}}, "required": ["count", "per"], "additionalProperties": false},
        {"type": "null"}
      ],
      "description": "Shared date-night goal; member-writable."
    },
    "pet": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "species": {"enum": ["bunny", "kitten", "puppy", "fox", "panda", "chick", "koala", "frog"]},
            "name": {"type": "string", "minLength": 1, "maxLength": 20},
            "hatchedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
            "lastFed": {"type": "object", "additionalProperties": {"$ref": "common.schema.json#/$defs/timestamp"}},
            "lastPlayed": {"type": "object", "additionalProperties": {"$ref": "common.schema.json#/$defs/timestamp"}}
          },
          "required": ["species", "name", "hatchedAt"],
          "additionalProperties": false
        },
        {"type": "null"}
      ],
      "description": "The pet that hatched from the plant (stage >= 3). Its size follows plant.stage."
    },
    "home": {
      "type": "object",
      "properties": {
        "wallpaper": {"type": "string", "maxLength": 24},
        "owned": {"type": "array", "maxItems": 64, "items": {"type": "string"}},
        "placed": {
          "type": "array",
          "maxItems": 30,
          "items": {"type": "object", "properties": {"id": {"type": "string"}, "x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}}, "required": ["id", "x", "y"]}
        },
        "spent": {"type": "integer", "minimum": 0, "description": "Love points spent; only grows, never above what was earned (see firestore.rules validHome)."}
      },
      "description": "The pet's shared home."
    },
    "lastMetAt": {"oneOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}], "description": "When the two last met in person; member-writable, not in the future."},
    "latestItemByUser": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "itemId": {"type": "string"},
          "type": {"$ref": "common.schema.json#/$defs/itemType"},
          "thumbPath": {"type": ["string", "null"]},
          "caption": {"type": "string", "maxLength": 40},
          "secret": {"type": "boolean"},
          "sentAt": {"$ref": "common.schema.json#/$defs/timestamp"}
        },
        "required": ["itemId", "type", "sentAt"]
      }
    },
    "streak": {
      "type": "object",
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "best": {"type": "integer", "minimum": 0},
        "lastBothActiveDate": {"oneOf": [{"$ref": "common.schema.json#/$defs/dateKey"}, {"type": "null"}]},
        "freezesLeft": {"type": "integer", "minimum": 0},
        "freezesMonth": {"type": ["string", "null"]},
        "activeToday": {"type": "array", "items": {"type": "string"}},
        "activeDate": {"type": ["string", "null"]},
        "checkedThrough": {"type": ["string", "null"]},
        "lastFrozeDate": {"type": ["string", "null"]},
        "lostCount": {"type": "integer", "minimum": 0},
        "brokeDate": {"type": ["string", "null"]}
      }
    },
    "plant": {
      "type": "object",
      "properties": {
        "stage": {"type": "integer", "minimum": 0, "maximum": 8},
        "health": {"enum": ["healthy", "wilted"]},
        "species": {"type": "string"}
      }
    },
    "premium": {
      "type": "object",
      "properties": {
        "active": {"type": "boolean"},
        "source": {"const": "subscription"},
        "ownerUid": {"type": ["string", "null"]},
        "expiresAt": {"oneOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]}
      }
    },
    "ownedPacks": {"type": "array", "items": {"type": "string"}},
    "widgetTheme": {"type": "object", "additionalProperties": {"type": "string"}},
    "stats": {
      "type": "object",
      "properties": {
        "itemsSent": {"type": "integer"},
        "questionsAnswered": {"type": "integer"},
        "tapsSent": {"type": "integer"}
      }
    },
    "questionPack": {"enum": ["everyday", "deep", "longDistance", "bestFriends", "spicy"]},
    "questionCursor": {"type": "object", "additionalProperties": {"type": "integer"}},
    "lastTapByUser": {"type": "object", "additionalProperties": {"$ref": "common.schema.json#/$defs/timestamp"}},
    "unpairedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
    "unpairedBy": {"type": "string"},
    "deleteAfter": {"$ref": "common.schema.json#/$defs/timestamp"}
  },
  "required": ["memberIds", "mode", "status", "pairedAt"]
}
