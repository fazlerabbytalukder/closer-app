{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://closer.app/schema/item.schema.json",
  "title": "pairs/{pairId}/items/{itemId}",
  "description": "Written by sendItem (reactions by reactItem, revealedAt by revealAdmirer). Paths are Cloud Storage paths.",
  "type": "object",
  "properties": {
    "type": {"$ref": "common.schema.json#/$defs/itemType"},
    "senderId": {"$ref": "common.schema.json#/$defs/uid"},
    "storagePath": {"type": ["string", "null"], "pattern": "^pairs/[^/]+/raw/[^/]+\\.jpg$"},
    "thumbPath": {"type": ["string", "null"], "pattern": "^pairs/[^/]+/thumbs/[^/]+\\.jpg$"},
    "caption": {"type": "string", "maxLength": 40},
    "text": {"type": ["string", "null"], "maxLength": 500},
    "noteStyle": {
      "type": ["object", "null"],
      "properties": {"bg": {"type": "string"}, "font": {"type": "string"}},
      "required": ["bg", "font"]
    },
    "geo": {
      "description": "Only for type=location.",
      "type": ["object", "null"],
      "properties": {
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lng": {"type": "number", "minimum": -180, "maximum": 180},
        "place": {"type": "string", "maxLength": 80}
      },
      "required": ["lat", "lng", "place"]
    },
    "saveToMemories": {"type": "boolean"},
    "reactions": {
      "description": "uid -> emoji. Written by reactItem.",
      "type": "object",
      "additionalProperties": {"enum": ["❤️", "😍", "🥹", "😂", "😘", "🔥", "👏"]}
    },
    "secret": {"type": "boolean", "description": "Sent by a secret admirer; the app hides the sender until revealedAt."},
    "revealedAt": {"oneOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}], "description": "Set by revealAdmirer."},
    "createdAt": {"$ref": "common.schema.json#/$defs/timestamp"}
  },
  "required": ["type", "senderId", "caption", "saveToMemories", "createdAt"],
  "additionalProperties": false
}
