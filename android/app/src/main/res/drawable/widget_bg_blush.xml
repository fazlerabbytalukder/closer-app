<?xml version="1.0" encoding="utf-8"?>
<!-- "blush" widget theme: diagonal gradient with soft light bubbles (matches the app's hero). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF5C8A" android:centerColor="#FF7FA3" android:endColor="#FFB0C8" android:type="linear" />
            <corners android:radius="@dimen/widget_corner_radius" />
        </shape>
    </item>
    <item android:gravity="top|end" android:width="150dp" android:height="150dp" android:top="-60dp" android:right="-50dp">
        <shape android:shape="oval"><solid android:color="#1FFFFFFF" /></shape>
    </item>
    <item android:gravity="bottom|start" android:width="110dp" android:height="110dp" android:bottom="-50dp" android:left="-40dp">
        <shape android:shape="oval"><solid android:color="#14FFFFFF" /></shape>
    </item>
</layer-list>
